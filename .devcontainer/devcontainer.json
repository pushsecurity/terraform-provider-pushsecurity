{
  "name": "terraform-provider-pushsecurity",

  "image": "mcr.microsoft.com/devcontainers/go:2-1.26-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      // Matches the newest entry in the CI acceptance matrix. post-create.sh
      // also drops the oldest supported line (1.8) in as `terraform1.8`.
      "version": "1.16",
      "tflint": "latest",
      "terragrunt": "none",
      // docs/ is generated by tfplugindocs (installed in post-create.sh), which
      // is what CI checks; terraform-docs is a different tool and unused here.
      "installTerraformDocs": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "containerEnv": {
    // The image's GOPATH is /go and /go/bin is already on PATH. The
    // dev_overrides block post-create.sh writes to ~/.terraformrc points here,
    // so `make install` is the whole build step before a manual plan.
    "GOBIN": "/go/bin",
    "TF_CLI_CONFIG_FILE": "/home/vscode/.terraformrc",

    // Deliberately 1, not 0: `make test` and `make testacc` both run
    // `go test -race`, and the race detector requires cgo — with CGO_ENABLED=0
    // every test target fails outright with "-race requires cgo". Release
    // builds get their static linking from the per-build `CGO_ENABLED=0` in
    // .goreleaser.yml, so nothing depends on it being set here.
    "CGO_ENABLED": "1"
  },

  "remoteEnv": {
    // Dev Containers copies the host ~/.gitconfig in verbatim. If it sets
    // http.sslCAInfo to a CA bundle that exists only on the host, git over
    // HTTPS fails with a TLS error inside the container. GIT_SSL_CAINFO
    // overrides that config with the container's own bundle, and survives the
    // recopy the extension does on every container start.
    "GIT_SSL_CAINFO": "/etc/ssl/certs/ca-certificates.crt"
  },

  // Module and build caches survive a rebuild — a cold `go mod download` of
  // terraform-plugin-framework plus the plugin-testing tree is otherwise
  // minutes. These are the image's real GOMODCACHE and GOCACHE; mounting at
  // $HOME/go silently caches nothing. Volume names are provider-specific so
  // this container shares no state with other Go devcontainers.
  "mounts": [
    "source=push-provider-gomodcache,target=/go/pkg/mod,type=volume",
    "source=push-provider-gobuildcache,target=/home/vscode/.cache/go-build,type=volume"
  ],

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "hashicorp.terraform",
        "hashicorp.hcl",
        "github.vscode-github-actions",
        "redhat.vscode-yaml",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,

        "go.toolsManagement.autoUpdate": false,
        "go.useLanguageServer": true,
        // Same linter and version CI runs, so an editor warning is a CI failure.
        "go.lintTool": "golangci-lint",
        "go.lintFlags": ["--fast-only"],
        // Acceptance tests create and destroy real Push configuration; the 30s
        // default kills them mid-flight and leaves the tenant half-written.
        "go.testTimeout": "30m",
        "go.testFlags": ["-v"],
        // Running an acceptance test from the editor gutter needs TF_ACC set;
        // leaving it out of the environment is what keeps a plain test run
        // offline, so set it per-run instead of here.
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
        },

        // examples/ is checked with `terraform fmt -check` by `make lint`.
        "[terraform]": { "editor.defaultFormatter": "hashicorp.terraform" },
        "[terraform-vars]": { "editor.defaultFormatter": "hashicorp.terraform" }
      }
    }
  },

  "remoteUser": "vscode"
}
