# Copy to .env (gitignored) and fill in. Create the key under Settings in the
# Push admin console; "Full access" is needed for anything beyond a read-only
# plan or terraform query.
#
# Acceptance tests replace whole control configurations and destroy what they
# create: point this at a dedicated test tenant, never one holding anything real.
PUSH_API_KEY=
# Override only if you are pointing at something other than production.
# PUSH_BASE_URL=https://api.pushsecurity.com
